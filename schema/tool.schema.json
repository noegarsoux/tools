{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Creative coding tool",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "title", "type", "description", "author", "created", "status"],
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Identique au nom du dossier." },
    "title": { "type": "string", "minLength": 3, "maxLength": 40 },
    "type": {
      "enum": ["generative", "shader", "typography", "color", "pattern", "image", "animation", "audio", "3d", "utility"]
    },
    "description": { "type": "string", "minLength": 40, "maxLength": 180 },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "maxItems": 6 },
    "author": { "enum": ["claude", "cursor", "human"] },
    "created": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "status": { "enum": ["finished"] }
  }
}
